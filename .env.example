# Copy this file to .env and fill in your own values before running the server

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins your frontend runs on (Live Server, http.server, etc.)
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# OTP settings
OTP_MODE=console
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# --- Real email delivery: set OTP_MODE=email above, then fill these in ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
